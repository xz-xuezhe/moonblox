// Directive argument parser for MoonBlox

import {
  "xz-xuezhe/moonblox/ast",
  "moonbitlang/core/list",
}

options(
  "pre-build": [
    {
      "command": "$mod_dir/.mooncakes/moonbitlang/yacc/moonyacc $input -o $output",
      "input": "parser.mbty",
      "output": "parser.mbt",
    },
  ],
)
