import {
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/x/fs",
  "moonbitlang/async",
  "moonbitlang/async/fs" @afs,
  "moonbitlang/async/http",
  "moonbitlang/async/process",
  "moonbitlang/async/socket",
  "moonbitlang/async/websocket",
  "Yoorkin/ArgParser",
  "xz-xuezhe/moonblox/convert",
}

supported_targets = "native"

options(
  "is-main": true,
  "pre-build": [
    {
      "command": ":embed -i $input -o $output --name base_css",
      "input": "../../lib/templates/theme/base.css",
      "output": "base_css.mbt",
    },
    {
      "command": ":embed -i $input -o $output --name badge_mbt",
      "input": "../../lib/templates/components/badge/badge.mbt",
      "output": "badge_mbt.mbt",
    },
    {
      "command": ":embed -i $input -o $output --name badge_css",
      "input": "../../lib/templates/components/badge/badge.css",
      "output": "badge_css.mbt",
    },
    {
      "command": ":embed -i $input -o $output --name counter_mbt",
      "input": "../../lib/templates/components/counter/counter.mbt",
      "output": "counter_mbt.mbt",
    },
    {
      "command": ":embed -i $input -o $output --name counter_css",
      "input": "../../lib/templates/components/counter/counter.css",
      "output": "counter_css.mbt",
    },
    {
      "command": ":embed -i $input -o $output --name callout_mbt",
      "input": "../../lib/templates/components/callout/callout.mbt",
      "output": "callout_mbt.mbt",
    },
    {
      "command": ":embed -i $input -o $output --name callout_css",
      "input": "../../lib/templates/components/callout/callout.css",
      "output": "callout_css.mbt",
    },
    {
      "command": ":embed -i $input -o $output --name page_shell",
      "input": "../../lib/templates/page_shell.html",
      "output": "page_shell.mbt",
    },
    {
      "command": ":embed -i $input -o $output --name live_reload_script",
      "input": "../../lib/templates/live_reload.js",
      "output": "live_reload_script.mbt",
    },
    {
      "command": ":embed -i $input -o $output --name sample_post_md",
      "input": "../../lib/templates/sample_post.md",
      "output": "sample_post_md.mbt",
    },
    {
      "command": ":embed -i $input -o $output --name default_config_json",
      "input": "../../lib/templates/moonblox.json",
      "output": "default_config_json.mbt",
    },
    {
      "command": ":embed -i $input -o $output --name badge_moon_pkg",
      "input": "../../lib/templates/components/badge/moon.pkg",
      "output": "badge_moon_pkg.mbt",
    },
    {
      "command": ":embed -i $input -o $output --name counter_moon_pkg",
      "input": "../../lib/templates/components/counter/moon.pkg",
      "output": "counter_moon_pkg.mbt",
    },
    {
      "command": ":embed -i $input -o $output --name callout_moon_pkg",
      "input": "../../lib/templates/components/callout/moon.pkg",
      "output": "callout_moon_pkg.mbt",
    },
  ],
)
