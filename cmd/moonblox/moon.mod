name = "xz-xuezhe/moonblox-cli"

version = "0.2.0"

import {
  "xz-xuezhe/moonblox@0.2.0",
  "moonbitlang/x@0.4.45",
  "moonbitlang/async@0.19.3",
  "TheWaWaR/clap@0.2.6",
  "moonbit-community/rabbita@0.12.4",
  "moonbit-community/rabbita_tui@0.1.0",
  "mizchi/markdown@0.6.2",
}

preferred_target = "native"

readme = "README.md"

repository = "https://github.com/xz-xuezhe/moonblox"

license = "Apache-2.0"

keywords = [ "markdown", "ssg", "moonbit", "site-generator" ]

description = "MoonBlox command-line tool"
