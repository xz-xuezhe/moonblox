      "output": "graph_mbt.mbt",
    },
    {
      "command": ":embed -i $input -o $output --name _graph_css",
      "input": "../templates/components/graph/graph.css",
      "output": "graph_css.mbt",
    },
    {
      "command": ":embed -i $input -o $output --name _graph_moon_pkg",
      "input": "../templates/components/graph/moon.pkg",
      "output": "graph_moon_pkg.mbt",
    },
    {
      "command": ":embed -i $input -o $output --name _sidebar_mbt",
      "input": "../templates/components/sidebar/sidebar.mbt",
      "output": "sidebar_mbt.mbt",
    },
    {
      "command": ":embed -i $input -o $output --name _sidebar_css",
      "input": "../templates/components/sidebar/sidebar.css",
      "output": "sidebar_css.mbt",
    },
    {
      "command": ":embed -i $input -o $output --name _sidebar_moon_pkg",
      "input": "../templates/components/sidebar/moon.pkg",
      "output": "sidebar_moon_pkg.mbt",
    },
    {
      "command": ":embed -i $input -o $output --name _breadcrumbs_mbt",
      "input": "../templates/components/breadcrumbs/breadcrumbs.mbt",
      "output": "breadcrumbs_mbt.mbt",
    },
    {
      "command": ":embed -i $input -o $output --name _breadcrumbs_css",
      "input": "../templates/components/breadcrumbs/breadcrumbs.css",
      "output": "breadcrumbs_css.mbt",
    },
