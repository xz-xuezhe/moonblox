/// moonblox build — scan, generate, compile, assemble dist/

async fn main {
  let args = @env.args()
  guard args.length() >= 3 else {
    println("Usage: moonblox build <project_dir>")
    return
  }
  let dir = args[2]
  guard @fs.path_exists(dir) else {
    println("Error: directory not found: \{dir}")
    return
  }

  // 1. Scan components, generate _registry.mbt
  let comp_dir = "\{dir}/components"
  try {
    scan_components(comp_dir, dir)
  } catch {
    _ => println("Warning: scan failed")
  }

  // 2. Generate main.mbt from markdown
  let posts_dir = "\{dir}/posts"
  try {
    if @fs.path_exists(posts_dir) {
      let files = @fs.read_dir(posts_dir)
      for i = 0; i < files.length(); i = i + 1 {
        let name = files[i]
        if name.has_suffix(".md") {
          let path = "\{posts_dir}/\{name}"
          let content = @fs.read_file_to_string(path)
          let main_mbt = generate_main_mbt(content)
          @fs.write_string_to_file("\{dir}/main.mbt", main_mbt)
          println("Generated: main.mbt from \{name}")
        }
      }
    }
  } catch {
    _ => println("Warning: markdown processing failed")
  }

  // 3. Collect CSS: base.css + component .css files
  let css = collect_css(dir)

  // 4. Run moon build --target js --release (like warren)
  println("Building JS...")
  let result = @process.run("moon", ["build", "--target", "js", "--release"], cwd=dir)
  guard result == 0 else {
    println("Error: moon build failed with exit code \{result}")
    return
  }

  // 5. Assemble dist/
  let dist_dir = "\{dir}/dist"
  try {
    if @fs.path_exists(dist_dir) {
      for f in @fs.read_dir(dist_dir) {
        try @fs.remove_file("\{dist_dir}/\{f}") catch { _ => () }
      }
    } else {
      try! @fs.create_dir(dist_dir)
    }
  } catch {
    _ => println("Warning: dist setup failed")
  }

  // Find and copy JS artifact (like warren's find_release_js)
  let js_dir = "\{dir}/_build/js/release/build"
  try {
    if @fs.path_exists(js_dir) {
      for f in @fs.read_dir(js_dir) {
        if f.has_suffix(".js") {
          let js = @fs.read_file_to_string("\{js_dir}/\{f}")
          @fs.write_string_to_file("\{dist_dir}/index.js", js)
          println("Copied: \{f} -> dist/index.js")
        }
      }
    }
  } catch {
    _ => println("Warning: JS copy failed")
  }

  // Write index.html from template
  try {
    let html = @fs.read_file_to_string("\{dir}/index.html")
    @fs.write_string_to_file("\{dist_dir}/index.html", html)
  } catch {
    _ => {
      let html = "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>MoonBlox</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <div id=\"app\"></div>\n  <script src=\"index.js\" type=\"module\"></script>\n</body>\n</html>\n"
      @fs.write_string_to_file("\{dist_dir}/index.html", html)
    }
  }

  if css != "" {
    try @fs.write_string_to_file("\{dist_dir}/style.css", css) catch { _ => () }
  }

  println("Built: \{dist_dir}/")
}

/// Scan components/*/ subdirectories and generate _registry.mbt
fn scan_components(dir : String, out_dir : String) -> Unit raise {
  guard @fs.path_exists(dir) else {
    println("Warning: no components/ directory")
    return
  }
  let subdirs = @fs.read_dir(dir)
  let inline_s : Array[String] = []
  let container_s : Array[String] = []
  for i = 0; i < subdirs.length(); i = i + 1 {
    let comp_name = subdirs[i]
    let comp_dir = "\{dir}/\{comp_name}"
    // Skip files, only process directories
    if @fs.path_exists("\{comp_dir}/moon.pkg") {
      let mbt_path = "\{comp_dir}/\{comp_name}.mbt"
      if @fs.path_exists(mbt_path) {
        let content = @fs.read_file_to_string(mbt_path)
        let has_cell = content.contains("_cell(args") || content.contains("_cell(args:")
        if has_cell {
          if content.contains(", body:") || content.contains(", body :") {
            container_s.push(comp_name)
          } else {
            inline_s.push(comp_name)
          }
        }
      }
    }
  }
  inline_s.sort()
  container_s.sort()

  let sb = StringBuilder::new()
  sb.write_string(
    #|// Auto-generated by scanner — DO NOT EDIT
    #|
    #|fn inline_cells() -> Map[String, (Map[String, @ast.Value]) -> @rabbita.Cell] {
    #|  let m : Map[String, (Map[String, @ast.Value]) -> @rabbita.Cell] = Map([])
    #|
  )
  for i = 0; i < inline_s.length(); i = i + 1 {
    let c = inline_s[i]
    sb.write_string("  m.set(\"\{c}\", fn(args) { @\{c}.\{c}_cell(args) })\n")
  }
  sb.write_string("  m\n}\n\n")
  sb.write_string(
    #|fn container_cells() -> Map[String, (Map[String, @ast.Value], String) -> @rabbita.Cell] {
    #|  let m : Map[String, (Map[String, @ast.Value], String) -> @rabbita.Cell] = Map([])
    #|
  )
  for i = 0; i < container_s.length(); i = i + 1 {
    let c = container_s[i]
    sb.write_string("  m.set(\"\{c}\", fn(args, body) { @\{c}.\{c}_cell(args, body) })\n")
  }
  sb.write_string("  m\n}\n")
  @fs.write_string_to_file("\{out_dir}/_registry.mbt", sb.to_string())
  println("Generated: _registry.mbt (\{inline_s.length()} inline, \{container_s.length()} container)")
}

/// Collect CSS: theme/base.css + component .css files (alphabetical)
fn collect_css(dir : String) -> String raise {
  let sb = StringBuilder::new()

  // Base styles first
  if @fs.path_exists("\{dir}/theme/base.css") {
    try {
      sb.write_string(@fs.read_file_to_string("\{dir}/theme/base.css"))
      sb.write_char('\n')
    } catch { _ => () }
  }

  // Component styles
  let comp_dir = "\{dir}/components"
  if @fs.path_exists(comp_dir) {
    let subdirs = @fs.read_dir(comp_dir)
    subdirs.sort()
    for i = 0; i < subdirs.length(); i = i + 1 {
      let name = subdirs[i]
      let css_path = "\{comp_dir}/\{name}/\{name}.css"
      if @fs.path_exists(css_path) {
        try {
          sb.write_string(@fs.read_file_to_string(css_path))
          sb.write_char('\n')
          println("Collected: " + name + "/" + name + ".css")
        } catch { _ => () }
      }
    }
  }

  sb.to_string()
}
