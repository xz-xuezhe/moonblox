/// moonblox build — scan, generate, compile, assemble dist/

async fn main {
  let args = @env.args()
  guard args.length() >= 3 else {
    println("Usage: moonblox build <project_dir>")
    return
  }
  let dir = args[2]
  guard @fs.path_exists(dir) else {
    println("Error: directory not found: \{dir}")
    return
  }

  // 1. Scan components, generate _registry.mbt
  let comp_dir = "\{dir}/components"
  try {
    scan_components(comp_dir, dir)
  } catch {
    _ => println("Warning: scan failed")
  }

  // 2. Generate main.mbt from markdown
  let posts_dir = "\{dir}/posts"
  try {
    if @fs.path_exists(posts_dir) {
      let files = @fs.read_dir(posts_dir)
      for i = 0; i < files.length(); i = i + 1 {
        let name = files[i]
        if name.has_suffix(".md") {
          let path = "\{posts_dir}/\{name}"
          let content = @fs.read_file_to_string(path)
          let main_mbt = generate_main_mbt(content)
          @fs.write_string_to_file("\{dir}/main.mbt", main_mbt)
          println("Generated: main.mbt from \{name}")
        }
      }
    }
  } catch {
    _ => println("Warning: markdown processing failed")
  }

  // 3. Read style.css (check root first, then theme/)
  let style_css = try {
    if @fs.path_exists("\{dir}/style.css") {
      @fs.read_file_to_string("\{dir}/style.css")
    } else if @fs.path_exists("\{dir}/theme/style.css") {
      @fs.read_file_to_string("\{dir}/theme/style.css")
    } else {
      ""
    }
  } catch {
    _ => ""
  }

  // 4. Run moon build --target js --release (like warren)
  println("Building JS...")
  let result = @process.run("moon", ["build", "--target", "js", "--release"], cwd=dir)
  guard result == 0 else {
    println("Error: moon build failed with exit code \{result}")
    return
  }

  // 5. Assemble dist/
  let dist_dir = "\{dir}/dist"
  try {
    if @fs.path_exists(dist_dir) {
      for f in @fs.read_dir(dist_dir) {
        try @fs.remove_file("\{dist_dir}/\{f}") catch { _ => () }
      }
    } else {
      try! @fs.create_dir(dist_dir)
    }
  } catch {
    _ => println("Warning: dist setup failed")
  }

  // Find and copy JS artifact (like warren's find_release_js)
  let js_dir = "\{dir}/_build/js/release/build"
  try {
    if @fs.path_exists(js_dir) {
      for f in @fs.read_dir(js_dir) {
        if f.has_suffix(".js") {
          let js = @fs.read_file_to_string("\{js_dir}/\{f}")
          @fs.write_string_to_file("\{dist_dir}/index.js", js)
          println("Copied: \{f} -> dist/index.js")
        }
      }
    }
  } catch {
    _ => println("Warning: JS copy failed")
  }

  // Write static shell
  let html =
    "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>MoonBlox</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <div id=\"app\"></div>\n  <script src=\"index.js\" type=\"module\"></script>\n</body>\n</html>\n"
  try @fs.write_string_to_file("\{dist_dir}/index.html", html) catch { _ => () }

  if style_css != "" {
    try @fs.write_string_to_file("\{dist_dir}/style.css", style_css) catch { _ => () }
  }

  println("Built: \{dist_dir}/")
}

/// Scan components directory and generate _registry.mbt
fn scan_components(dir : String, out_dir : String) -> Unit raise {
  guard @fs.path_exists(dir) else {
    println("Warning: no components/ directory")
    return
  }
  let files = @fs.read_dir(dir)
  let inline_s : Array[String] = []
  let container_s : Array[String] = []
  for i = 0; i < files.length(); i = i + 1 {
    let name = files[i]
    if name.has_suffix(".mbt") && name != "_registry.mbt" {
      let path = "\{dir}/\{name}"
      let content = @fs.read_file_to_string(path)
      let has_cell = content.contains("_cell(args") || content.contains("_cell(args:")
      if has_cell {
        let comp_name = name[0:name.length() - 4].to_owned()
        if content.contains(", body:") || content.contains(", body :") {
          container_s.push(comp_name)
        } else {
          inline_s.push(comp_name)
        }
      }
    }
  }
  let sb = StringBuilder::new()
  sb.write_string("// Auto-generated by scanner — DO NOT EDIT\n\n")
  sb.write_string("fn inline_cells() -> Map[String, (Map[String, @ast.Value]) -> @rabbita.Cell] {\n")
  sb.write_string("  let m : Map[String, (Map[String, @ast.Value]) -> @rabbita.Cell] = Map([])\n")
  for i = 0; i < inline_s.length(); i = i + 1 {
    let c = inline_s[i]
    sb.write_string("  m.set(\"")
    sb.write_string(c)
    sb.write_string("\", fn(args) { @components.")
    sb.write_string(c)
    sb.write_string("_cell(args) })\n")
  }
  sb.write_string("  m\n}\n\n")
  sb.write_string("fn container_cells() -> Map[String, (Map[String, @ast.Value], String) -> @rabbita.Cell] {\n")
  sb.write_string("  let m : Map[String, (Map[String, @ast.Value], String) -> @rabbita.Cell] = Map([])\n")
  for i = 0; i < container_s.length(); i = i + 1 {
    let c = container_s[i]
    sb.write_string("  m.set(\"")
    sb.write_string(c)
    sb.write_string("\", fn(args, body) { @components.")
    sb.write_string(c)
    sb.write_string("_cell(args, body) })\n")
  }
  sb.write_string("  m\n}\n")
  @fs.write_string_to_file("\{out_dir}/_registry.mbt", sb.to_string())
  println("Generated: _registry.mbt (\{inline_s.length()} inline, \{container_s.length()} container)")
}
