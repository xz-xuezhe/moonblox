// Markdown string → main.mbt generator

///|
fn escape_md(s : String) -> String {
  let sb = StringBuilder::new()
  for i = 0; i < s.length(); i = i + 1 {
    match s.get_char(i) {
      Some('\\') => sb.write_string("\\\\")
      Some('"') => sb.write_string("\\\"")
      Some('\n') => sb.write_string("\\n")
      Some(c) => sb.write_char(c)
      None => ()
    }
  }
  sb.to_string()
}

///|
pub fn generate_main_mbt(md_content : String) -> String {
  let escaped = escape_md(md_content)
  "// Generated by moonblox build — DO NOT EDIT\n\nfn main {\n  let md = \"\{escaped}\"\n  let doc = @convert.parse_markdown(md)\n  let cell = @render.render_document(doc, inline_cells=inline_cells(), container_cells=container_cells())\n  @rabbita.new(cell).mount(\"app\")\n}\n"
}
