// Markdown string → main.mbt generator

///|
fn escape_md(s : String) -> String {
  let sb = StringBuilder::new()
  for i = 0; i < s.length(); i = i + 1 {
    match s.get_char(i) {
      Some('\\') => sb.write_string("\\\\")
      Some('"') => sb.write_string("\\\"")
      Some('\n') => sb.write_string("\\n")
      Some(c) => sb.write_char(c)
      None => ()
    }
  }
  sb.to_string()
}

///|
pub fn generate_main_mbt(md_content : String) -> String {
  let sb = StringBuilder::new()
  sb.write_string("// Generated by moonblox build — DO NOT EDIT\n\n")
  sb.write_string("fn main {\n")
  sb.write_string("  let md = \"")
  sb.write_string(escape_md(md_content))
  sb.write_string("\"\n")
  sb.write_string("  let doc = @convert.parse_markdown(md)\n")
  sb.write_string("  let cell = @render.render_document(doc, inline_cells=inline_cells(), container_cells=container_cells())\n")
  sb.write_string("  @rabbita.new(cell).mount(\"app\")\n")
  sb.write_string("}\n")
  sb.to_string()
}
